# ========================================================
# 1. APPLICATION & NETWORK CONFIG
# ========================================================
NODE_ENV=production
PORT=3001
# URL Frontend cho phép gọi API qua CORS (nhiều domain phân cách bởi dấu phẩy)
FRONTEND_URL=http://localhost:3000,https://your-frontend-domain.com
# Bật (true) hoặc tắt (false) tài liệu Swagger tại /api/docs
SWAGGER_ENABLED=true

# ========================================================
# 2. SUPABASE DATABASE
# ========================================================
SUPABASE_URL=https://your-project.supabase.co
# API Key (Khuyến nghị dùng service_role key trên backend)
SUPABASE_KEY=your-supabase-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/rest/v1/auth/v1/jwks

# ========================================================
# 3. CLOUDINARY MEDIA STORAGE
# ========================================================
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
